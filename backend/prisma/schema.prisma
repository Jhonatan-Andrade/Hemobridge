// Modelo de dados do Hemobridge: agendamento de doação de sangue em hemocentros
// (ver docs/requisitos.md e docs/der.md). Regras que o Prisma não expressa
// (CHECK e índices únicos parciais) ficam no SQL das migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Perfil {
  PACIENTE
  EQUIPE
  ADMIN_PLATAFORMA

  @@map("perfil")
}

// Acesso à plataforma. ENCERRADO = dados excluídos/anonimizados (RF16).
enum StatusUsuario {
  ATIVO
  INATIVO
  ENCERRADO

  @@map("status_usuario")
}

// Papel de quem trabalha no hemocentro (perfil EQUIPE).
enum PapelEquipe {
  MEDICO
  ADMIN_HEMOCENTRO

  @@map("papel_equipe")
}

// Sexo do paciente: define o intervalo mínimo e o limite anual de doações (Ministério da Saúde).
enum Sexo {
  MASCULINO
  FEMININO

  @@map("sexo")
}

// Status da conta do paciente: nasce PENDENTE e vira ATIVA (doador) na ativação (RF13).
enum SituacaoPaciente {
  PENDENTE
  ATIVA

  @@map("situacao_paciente")
}

// RF17: nível informado pelo Admin do hemocentro para cada tipo sanguíneo.
enum NivelNecessidade {
  URGENTE
  NECESSARIO
  ESTAVEL

  @@map("nivel_necessidade")
}

enum GrupoAbo {
  A
  B
  AB
  O

  @@map("grupo_abo")
}

enum FatorRh {
  POSITIVO
  NEGATIVO

  @@map("fator_rh")
}

enum StatusAgendamento {
  AGENDADO
  CANCELADO
  CONCLUIDO
  AUSENTE

  @@map("status_agendamento")
}

// ---------------------------------------------------------------------------
// Identidade e perfis
// ---------------------------------------------------------------------------

model Usuario {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String        @db.VarChar(150)
  email                   String        @unique @db.VarChar(254)
  // Nulo depois da exclusão de dados (RF16).
  cpf                     String?       @unique @db.Char(11)
  telefone                String?       @db.VarChar(20)
  senhaHash               String        @map("senha_hash")
  senhaProvisoria         Boolean       @default(false) @map("senha_provisoria")
  senhaProvisoriaExpiraEm DateTime?     @map("senha_provisoria_expira_em") @db.Timestamptz(3)
  senhaResetTokenHash     String?       @unique @map("senha_reset_token_hash")
  senhaResetExpiraEm      DateTime?     @map("senha_reset_expira_em") @db.Timestamptz(3)
  senhaResetUsadoEm       DateTime?     @map("senha_reset_usado_em") @db.Timestamptz(3)
  perfil                  Perfil
  status                  StatusUsuario @default(ATIVO)
  tentativasLogin         Int           @default(0) @map("tentativas_login") @db.SmallInt
  bloqueadoAte            DateTime?     @map("bloqueado_ate") @db.Timestamptz(3)
  // Incrementada ao trocar a senha ou sair: invalida os tokens emitidos antes.
  versaoSessao            Int           @default(0) @map("versao_sessao")
  criadoEm                DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm            DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  paciente       Paciente?
  equipe         MembroEquipe?
  consentimentos ConsentimentoLgpd[]

  necessidadesAtualizadas Necessidade[]
  auditorias              Auditoria[]

  @@index([perfil, status])
  @@map("usuario")
}

model Paciente {
  usuarioId       String           @id @map("usuario_id") @db.Uuid
  // Nula depois da exclusão de dados (RF16).
  dataNascimento  DateTime?        @map("data_nascimento") @db.Date
  // Obrigatório no cadastro; nulo em contas anteriores a ele e depois da exclusão (RF16).
  sexo            Sexo?
  situacao        SituacaoPaciente @default(PENDENTE)
  // Gravado só na ativação, a partir da doação registrada; o paciente nunca edita.
  tipoSanguineoId Int?             @map("tipo_sanguineo_id") @db.SmallInt
  ativadoPorId    String?          @map("ativado_por") @db.Uuid
  ativadoEm       DateTime?        @map("ativado_em") @db.Timestamptz(3)

  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipoSanguineo TipoSanguineo? @relation(fields: [tipoSanguineoId], references: [id], onDelete: Restrict)
  ativadoPor    MembroEquipe?  @relation("AtivadoPor", fields: [ativadoPorId], references: [usuarioId], onDelete: Restrict)

  agendamentos Agendamento[]
  doacoes      Doacao[]

  @@index([situacao])
  @@map("paciente")
}

// Equipe do hemocentro: cada membro pertence a um único hemocentro.
model MembroEquipe {
  usuarioId    String      @id @map("usuario_id") @db.Uuid
  hemocentroId String      @map("hemocentro_id") @db.Uuid
  papel        PapelEquipe

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  hemocentro Hemocentro @relation(fields: [hemocentroId], references: [id], onDelete: Restrict)

  doacoesRegistradas Doacao[]
  pacientesAtivados  Paciente[] @relation("AtivadoPor")

  @@index([hemocentroId, papel])
  @@map("equipe_hemocentro")
}

// ---------------------------------------------------------------------------
// Proteção de dados (LGPD)
// ---------------------------------------------------------------------------

// RF01: aceite versionado do termo de consentimento.
model ConsentimentoLgpd {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  versaoTermo String    @map("versao_termo") @db.VarChar(20)
  finalidade  String    @db.VarChar(255)
  aceitoEm    DateTime  @default(now()) @map("aceito_em") @db.Timestamptz(3)
  ipOrigem    String?   @map("ip_origem") @db.Inet
  revogadoEm  DateTime? @map("revogado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("consentimento_lgpd")
}

// RNF05: acesso e alteração de dados sensíveis. Só inserção; nunca alterado.
model Auditoria {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String   @map("usuario_id") @db.Uuid
  acao         String   @db.VarChar(50)
  entidade     String   @db.VarChar(50)
  entidadeId   String?  @map("entidade_id") @db.Uuid
  // Hemocentro de quem fez o acesso (nulo para paciente e administrador da plataforma).
  hemocentroId String?  @map("hemocentro_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  hemocentro Hemocentro? @relation(fields: [hemocentroId], references: [id], onDelete: Restrict)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@map("auditoria")
}

// ---------------------------------------------------------------------------
// Tipagem sanguínea
// ---------------------------------------------------------------------------

// Os oito tipos ABO/Rh.
model TipoSanguineo {
  id       Int      @id @default(autoincrement()) @db.SmallInt
  sigla    String   @unique @db.VarChar(3)
  grupoAbo GrupoAbo @map("grupo_abo")
  fatorRh  FatorRh  @map("fator_rh")

  pacientes    Paciente[]
  necessidades Necessidade[]
  doacoes      Doacao[]

  @@unique([grupoAbo, fatorRh])
  @@map("tipo_sanguineo")
}

// ---------------------------------------------------------------------------
// Hemocentros
// ---------------------------------------------------------------------------

model Hemocentro {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                 String   @db.VarChar(150)
  cnpj                 String   @unique @db.Char(14)
  endereco             String   @db.VarChar(255)
  cidade               String   @db.VarChar(100)
  estado               String   @db.Char(2)
  cep                  String   @db.Char(8)
  telefone             String?  @db.VarChar(20)
  horarioFuncionamento String?  @map("horario_funcionamento") @db.VarChar(255)
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  equipe       MembroEquipe[]
  horarios     Horario[]
  necessidades Necessidade[]
  doacoes      Doacao[]
  auditorias   Auditoria[]

  @@index([ativo, estado])
  @@map("hemocentro")
}

// RF17: no máximo um nível por hemocentro e tipo; tipo sem registro = não informado.
model Necessidade {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hemocentroId    String           @map("hemocentro_id") @db.Uuid
  tipoSanguineoId Int              @map("tipo_sanguineo_id") @db.SmallInt
  nivel           NivelNecessidade
  atualizadoPorId String           @map("atualizado_por") @db.Uuid
  atualizadoEm    DateTime         @map("atualizado_em") @db.Timestamptz(3)

  hemocentro    Hemocentro    @relation(fields: [hemocentroId], references: [id], onDelete: Restrict)
  tipoSanguineo TipoSanguineo @relation(fields: [tipoSanguineoId], references: [id], onDelete: Restrict)
  atualizadoPor Usuario       @relation(fields: [atualizadoPorId], references: [id], onDelete: Restrict)

  @@unique([hemocentroId, tipoSanguineoId])
  @@index([tipoSanguineoId, nivel])
  @@map("necessidade")
}

// ---------------------------------------------------------------------------
// Horários, agendamentos e doações
// ---------------------------------------------------------------------------

// RF08: horário de atendimento com a quantidade de pacientes que o hemocentro atende.
// Data e horas no fuso de Brasília.
model Horario {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hemocentroId String   @map("hemocentro_id") @db.Uuid
  data         DateTime @db.Date
  horaInicio   DateTime @map("hora_inicio") @db.Time(0)
  horaFim      DateTime @map("hora_fim") @db.Time(0)
  vagasTotal   Int      @map("vagas_total") @db.SmallInt
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  hemocentro   Hemocentro    @relation(fields: [hemocentroId], references: [id], onDelete: Restrict)
  agendamentos Agendamento[]

  @@unique([hemocentroId, data, horaInicio])
  @@index([hemocentroId, data])
  @@map("horario")
}

// RF06/RF07. Vagas restantes = vagas_total − agendamentos AGENDADO do horário.
// O índice único parcial (um AGENDADO por paciente e horário) está na migration.
model Agendamento {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId   String            @map("paciente_id") @db.Uuid
  horarioId    String            @map("horario_id") @db.Uuid
  status       StatusAgendamento @default(AGENDADO)
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  canceladoEm  DateTime?         @map("cancelado_em") @db.Timestamptz(3)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  paciente Paciente @relation(fields: [pacienteId], references: [usuarioId], onDelete: Restrict)
  horario  Horario  @relation(fields: [horarioId], references: [id], onDelete: Restrict)
  doacao   Doacao?

  @@index([horarioId, status])
  @@index([pacienteId, status])
  @@map("agendamento")
}

// RF11: registro do atendimento, sempre vinculado ao hemocentro que o fez.
// Outros hemocentros só leem (RF12); ninguém edita depois de registrado.
model Doacao {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId   String   @unique @map("agendamento_id") @db.Uuid
  pacienteId      String   @map("paciente_id") @db.Uuid
  hemocentroId    String   @map("hemocentro_id") @db.Uuid
  medicoId        String   @map("medico_id") @db.Uuid
  compareceu      Boolean
  doou            Boolean
  tipoSanguineoId Int?     @map("tipo_sanguineo_id") @db.SmallInt
  motivoNaoDoacao String?  @map("motivo_nao_doacao") @db.VarChar(500)
  observacoes     String?  @db.VarChar(2000)
  registradoEm    DateTime @default(now()) @map("registrado_em") @db.Timestamptz(3)

  agendamento   Agendamento    @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  paciente      Paciente       @relation(fields: [pacienteId], references: [usuarioId], onDelete: Restrict)
  hemocentro    Hemocentro     @relation(fields: [hemocentroId], references: [id], onDelete: Restrict)
  medico        MembroEquipe   @relation(fields: [medicoId], references: [usuarioId], onDelete: Restrict)
  tipoSanguineo TipoSanguineo? @relation(fields: [tipoSanguineoId], references: [id], onDelete: Restrict)

  @@index([pacienteId, registradoEm])
  @@index([hemocentroId, registradoEm])
  @@map("doacao")
}
