PORT=3333

# Banco (PostgreSQL + PostGIS) — suba com `docker compose up -d`
POSTGRES_USER=hemobridge
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=hemobridge
POSTGRES_PORT=5434
DATABASE_URL=postgresql://hemobridge:troque-esta-senha@localhost:5434/hemobridge

# Administrador inicial (RN16) — usado apenas pelo seed (`npx prisma db seed`).
ADMIN_NOME=Administrador Hemobridge
ADMIN_EMAIL=admin@hemobridge.local
ADMIN_CPF=52998224725
# Senha provisória (trocada no primeiro acesso). RN06: 8 a 128 caracteres, com
# letra maiúscula, letra minúscula e número — senão o seed falha.
ADMIN_SENHA_INICIAL=Troque-Esta-Senha1

# Autenticação (JWT) — gere um segredo longo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
JWT_EXPIRACAO=1h

# E-mail (desenvolvimento: Mailpit do docker-compose, interface em http://localhost:8025)
# Em produção, informe o SMTP real e, se houver autenticação, SMTP_USUARIO e SMTP_SENHA.
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_SENHA=
EMAIL_REMETENTE=Hemobridge <nao-responda@hemobridge.local>

# URL do frontend, usada nos links enviados por e-mail
FRONTEND_URL=http://localhost:5173

# CORS: origens que podem chamar a API pelo navegador, separadas por vírgula.
# Se omitido, usa FRONTEND_URL.
# CORS_ORIGENS=http://localhost:5173,https://hemobridge.exemplo.com

# Atrás de proxy reverso, informe quantos proxies confiar (ex.: 1) para que o
# limite de requisições use o IP real do cliente. Deixe vazio sem proxy.
# TRUST_PROXY=1

# Cria hospitais fictícios no seed (somente desenvolvimento/demonstração)
SEED_DADOS_EXEMPLO=false
